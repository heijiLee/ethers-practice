# Ethers.js 튜토리얼 환경 변수
# 이 파일을 복사해서 .env 파일을 만드세요: cp .env.example .env

# ============================================
# 개인키 (⚠️ 테스트 지갑만 사용하세요!)
# ============================================
PRIVATE_KEY=0x여기에_개인키_입력

# ============================================
# 지갑 주소들
# ============================================
# 메인 지갑 주소 (개인키에 해당하는 주소)
WALLET_ADDRESS=0x여기에_지갑_주소_입력

# 추가 지갑 주소 
WALLET_ADDRESS_2=0xAb5801a7D398351b8bE11C439e05C5B3259aeC9B # vitalik
WALLET_ADDRESS_3=0x0E58e8993100F1CBe45376c410F97f4893d9BfCD # UPbit 41

# 제출 주소
SUBMIT_ADDRESS=0xDEBE759E049971E222a0F6e5675Bfe31c86dfE5D

# ============================================
# RPC URLs (선택사항)
# ============================================
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

