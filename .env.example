# Ethers.js 튜토리얼 환경 변수
# 이 파일을 복사해서 .env 파일을 만드세요: cp .env.example .env

# ============================================
# 개인키 (⚠️ 테스트 지갑만 사용하세요!)
# ============================================
PRIVATE_KEY=0x여기에_개인키_입력

# ============================================
# 지갑 주소들
# ============================================
# 메인 지갑 주소 (개인키에 해당하는 주소)
WALLET_ADDRESS=0x여기에_지갑_주소_입력

# 추가 지갑 주소 (선택사항)
WALLET_ADDRESS_2=0x추가_주소_1
WALLET_ADDRESS_3=0x추가_주소_2

# 토큰/ETH를 받을 주소 (05-contract-write.js에서 사용)
SUBMIT_ADDRESS=0x토큰을_받을_주소

# ============================================
# 토큰 주소 (선택사항)
# ============================================
# 05-contract-write.js에서 생성한 토큰 주소
TOKEN_ADDRESS=0x토큰_주소_입력

# ============================================
# RPC URLs (선택사항)
# ============================================
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://eth.public-rpc.com

# ============================================
# API Keys (선택사항)
# ============================================
INFURA_API_KEY=your_infura_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
